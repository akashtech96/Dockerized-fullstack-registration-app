<!DOCTYPE html>
<html>

<head>

    <title>Registration Form</title>

    <link rel="stylesheet" href="/style.css">

</head>

<body>

    <h1>Registration Form</h1>

    <form action="/submit" method="POST">

        <label>Name</label>

        <input
            type="text"
            name="name"
            required>

        <br><br>

        <label>Password</label>

        <input
            type="password"
            name="password"
            required>

        <br><br>

        <button type="submit">

            Submit

        </button>

    </form>

</body>

</html>